# Token pessoal da API: https://www.football-data.org/client/register
FOOTBALL_API_TOKEN=seu_token_aqui

# Conexão do dlt e do dashboard ao PostgreSQL local
POSTGRES_URL=postgresql://football:football@localhost:5432/dbanalytics

# Conexão do dbt (dbt_project/profiles.yml)
PG_HOST=localhost
PG_USER=football
PG_PASSWORD=football

# Usado pelo Docker Compose para criar o banco e o usuário local
POSTGRES_DB=dbanalytics
POSTGRES_USER=football
POSTGRES_PASSWORD=football
